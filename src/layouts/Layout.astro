---
import { basics } from "../../cv.json";
import MouseStyle from "../components/react/CanvasWithEraser";
import Seo from "../components/Seo.astro";
import { SITE } from "../consts";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "profile" | "article";
  keywords?: string[];
  noindex?: boolean;
  schema?: unknown[];
  article?: { section?: string; tags?: string[] };
  /** Imagen que conviene precargar en esta página (LCP). */
  preload?: string;
}

const {
  title,
  description = basics.summary,
  image,
  imageAlt,
  type,
  keywords,
  noindex,
  schema,
  article,
  preload,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      keywords={keywords}
      noindex={noindex}
      schema={schema}
      article={article}
    />
    {preload && <link rel="preload" as="image" href={preload} />}
  </head>
  <body>
    <slot />
    <MouseStyle client:load />
  </body>
</html>

<style is:global>
  html {
    font-family:
      Georgia,
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: #fff;
    letter-spacing: -0.025rem;
  }

  body {
    cursor:
      url(/public/static/icons/rounded-pointer.svg) 12 12,
      auto;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      Georgia,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  p {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }
</style>
