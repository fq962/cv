---
import Section from "../Section.astro";

import { education } from "../../../cv.json";
import { getYear } from "../../consts";
---

<Section title="Educación">
  <ul class="flex flex-col gap-8">
    {
      education.map(({ institution, startDate, endDate, area, url }) => {
        const years = `${getYear(startDate)} - ${getYear(endDate)}`;

        return (
          <li>
            <a href={url} target="_blank" rel="noopener noreferrer">
              <header class="flex gap-4 justify-between">
                <div>
                  <h3 class="text-lg hover:underline">{area}</h3>
                </div>

                <time class="text-gray-600 text-xs md:text-sm text-nowrap">{years}</time>
              </header>

              <footer>
                <p class="mt-1">{institution}</p>
              </footer>
            </a>
          </li>
        );
      })
    }
  </ul>
</Section>
